// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum MealEnum {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  logs      MealLog[] 
}

model MealLog {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  mealType      MealEnum
  notes         String?
  totalCalories Float
  loggedAt      DateTime   @db.Date
  createdAt     DateTime   @default(now())
  foodItems     FoodItem[] 
}

model FoodItem {
  id           String  @id @default(uuid())
  mealLogId    String
  mealLog      MealLog @relation(fields: [mealLogId], references: [id])
  foodName     String
  servingGrams Float
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
}